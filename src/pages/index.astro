---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import Card from "../components/Card.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { featuredProducts } from "../data/featuredProducts";
import { categories } from "../data/categories";
import { activeTheme, landingCopy } from "../config/theme";

const seasonCopy = landingCopy[activeTheme];

// The season's lead slide supplies the hero photo, so it changes with the build season.
const heroImage = seasonCopy.slide1.image ?? {
  src: "/winter-collection/dachshund/dachshund-sweater-seafoam-front.webp",
  alt: "Dachshund Sweater",
};
const heroLink = seasonCopy.slide1.ctaLink;
const seasonName = activeTheme.charAt(0).toUpperCase() + activeTheme.slice(1);
const sentenceCase = (value: string) =>
  value.charAt(0).toUpperCase() + value.slice(1).toLowerCase();
---

<Layout
  title="Variety Gifts Unlimited - Unique and Fun Gifts"
  hideHeader={false}
>
  <div class="home">
    <section class="vg-wrap hero">
      <div class="vg-panel hero__box">
        <div class="hero__text">
          <h1 class="hero__title">Fun gifts for fun people.</h1>
          <p class="hero__lede">
            Cozy sweaters, cheeky tees and handmade crochet. Lots of good stuff,
            all in one place.
          </p>
          <a href="/shop" class="vg-btn">Browse the catalog</a>
        </div>
        <a href={heroLink} class="hero__art" aria-label={`Shop ${seasonName.toLowerCase()} picks`}>
          <span class="vg-badge hero__badge">New<br />for<br />{seasonName.toLowerCase()}!</span>
          <img src={heroImage.src} alt={heroImage.alt} class="hero__photo" />
        </a>
      </div>
    </section>

    <nav class="vg-wrap vg-chips home__chips" aria-label="Shop by category">
      {categories.map((category) => (
        <a href={`/shop/category/${category.slug}`} class="vg-chip">{category.name}</a>
      ))}
      <a href="/shop" class="vg-chip">Shop all</a>
      <a href="/game-browser" class="vg-chip">Free games</a>
    </nav>

    <section class="vg-wrap home__section">
      <h2 class="vg-title">{sentenceCase(seasonCopy.featuredHeading)}</h2>
      <p class="vg-sub">Our latest favorites, hot off the press.</p>
      <div class="vg-grid">
        {featuredProducts.map((product, index) => (
          <Card
            img={product.images[0].src}
            title={product.name}
            body={product.description}
            href={`/shop/product/${product.slug}`}
            price={product.price}
            disabled={product.disabled}
            number={index + 1}
          />
        ))}
      </div>
      <div class="home__more">
        <a href="/shop" class="vg-btn vg-btn--ghost">See the whole catalog</a>
      </div>
    </section>

    <section class="vg-wrap home__section">
      <div class="vg-panel split">
        <img src="/logos/bg-min.png" alt="Variety Gifts" class="split__img" loading="lazy" />
        <div>
          <h2 class="vg-title">About us</h2>
          <p class="split__text">{seasonCopy.aboutParagraph}</p>
          <a href="/contact" class="vg-btn">Say hello</a>
        </div>
      </div>
    </section>

    <section class="vg-wrap home__section">
      <div class="vg-panel split split--reverse">
        <img src="/game/shootout.webp" alt="Free games" class="split__img split__img--game" loading="lazy" />
        <div>
          <h2 class="vg-title">{sentenceCase(seasonCopy.gamesHeading)}</h2>
          <p class="split__text">{seasonCopy.gamesDescription}</p>
          <a href="/game-browser" class="vg-btn">{sentenceCase(seasonCopy.gamesCtaLabel)}</a>
        </div>
      </div>
    </section>

    <section class="vg-wrap home__section home__contact">
      <div class="contact__intro">
        <h2 class="vg-title">Get in touch</h2>
        <p class="split__text">Questions, ideas or just want to say hi? Send us a note.</p>
        <SocialLinks wrapperClass="contact__social" linkClass="contact__icon" />
        <img src="/logos/m_and_h_nobg.webp" alt="Halston and Matchima" class="contact__owners" loading="lazy" />
      </div>
      <div class="contact__form">
        <ContactForm />
      </div>
    </section>
  </div>
</Layout>

<style>
  .home {
    padding-bottom: 72px;
  }

  .hero {
    margin-top: 8px;
  }

  .hero__box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    position: relative;
  }

  .hero__text {
    padding: 56px 48px;
    align-self: center;
  }

  .hero__title {
    font-family: var(--vg-display);
    font-weight: 400;
    font-size: clamp(46px, 6vw, 84px);
    line-height: 0.98;
    margin: 0 0 18px;
    color: var(--vg-rust);
  }

  .hero__lede {
    font-size: 19px;
    line-height: 1.5;
    margin: 0 0 26px;
    max-width: 420px;
  }

  .hero__art {
    position: relative;
    min-height: 420px;
    background: radial-gradient(
      circle at 50% 110%,
      var(--vg-mustard) 0 30%,
      var(--vg-rust) 30% 45%,
      var(--vg-olive) 45% 60%,
      var(--vg-teal) 60% 75%,
      transparent 75%
    );
  }

  .hero__photo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(70%, 380px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) rotate(-3deg);
    object-fit: cover;
    background: #fff;
    border: 3px solid var(--vg-ink);
    border-radius: 24px;
    box-shadow: 8px 8px 0 var(--vg-ink);
    transition: transform 0.2s ease;
  }

  .hero__art:hover .hero__photo {
    transform: translate(-50%, -52%) rotate(-1deg);
  }

  .hero__badge {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
  }

  .home__chips {
    margin-top: 40px;
  }

  .home__section {
    margin-top: 72px;
  }

  .home__more {
    text-align: center;
    margin-top: 36px;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    align-items: center;
    padding: 40px;
  }

  .split--reverse > :first-child {
    order: 2;
  }

  .split__img {
    width: 100%;
    max-width: 380px;
    justify-self: center;
  }

  .split__img--game {
    max-width: 480px;
    aspect-ratio: 1.5;
    object-fit: cover;
    border: 3px solid var(--vg-ink);
    border-radius: 24px;
    box-shadow: 6px 6px 0 var(--vg-ink);
  }

  .split__text {
    font-size: 18px;
    line-height: 1.55;
    margin: 0 0 24px;
  }

  .home__contact {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 40px;
    align-items: start;
  }

  .home__contact :global(.contact__social) {
    display: flex;
    gap: 12px;
  }

  .home__contact :global(.contact__icon) {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--vg-rust);
    border: 3px solid var(--vg-ink);
    color: var(--vg-cream);
    box-shadow: 3px 3px 0 var(--vg-ink);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .home__contact :global(.contact__icon:hover) {
    background: var(--vg-teal);
    transform: translate(-2px, -2px);
  }

  .home__contact :global(.contact__icon svg) {
    width: 22px;
    height: 22px;
  }

  .contact__owners {
    width: 128px;
    height: 128px;
    margin-top: 24px;
    padding: 8px;
    border-radius: 50%;
    background: var(--vg-mustard);
    border: 3px solid var(--vg-ink);
  }

  @media (max-width: 860px) {
    .hero__box,
    .split,
    .home__contact {
      grid-template-columns: 1fr;
    }

    .hero__text {
      padding: 32px 24px 8px;
    }

    .hero__art {
      min-height: 340px;
    }

    .split {
      padding: 28px 22px;
      gap: 24px;
    }

    .split--reverse > :first-child {
      order: 0;
    }

    .home__section {
      margin-top: 56px;
    }
  }
</style>
