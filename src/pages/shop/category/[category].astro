---
import Layout from "../../../layouts/Layout.astro";
export const prerender = true;
import Card from "../../../components/Card.astro";
import { categories } from "../../../data/categories";
import { products } from "../../../data/products";
import { orderProductsForBuild } from "../../../data/productSeasonality";

export function getStaticPaths() {
    return categories.map(category => ({
        params: { category: category.slug },
        props: { category }
    }));
}

const { category } = Astro.props;
const categoryProducts = orderProductsForBuild(
    products.filter(p => p.category === category.id)
);

// Get the canonical URL for this category
const canonicalUrl = `https://www.variety.gifts/shop/category/${category.slug}`;
---

<Layout 
    title={`${category.name} - Variety Gifts Unlimited`} 
    hideHeader={false}
    description={category.description}
    ogTitle={`${category.name} - Variety Gifts Unlimited`}
    ogDescription={category.description}
    ogUrl={canonicalUrl}
>
    <div class="vg-wrap category">
        <nav class="category__crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a> / <a href="/shop">Shop</a> / <span>{category.name}</span>
        </nav>

        <section class="category__intro">
            <h1 class="category__title">{category.name}</h1>
            <p class="vg-sub">
                {category.description} · {categoryProducts.length} {categoryProducts.length === 1 ? 'product' : 'products'}
            </p>
        </section>

        <div class="vg-grid">
            {categoryProducts.map((product, index) => (
                <Card
                    img={product.images[0].src}
                    hoverImg={product.images[1]?.src}
                    title={product.name}
                    body={product.description}
                    href={`/shop/product/${product.slug}`}
                    price={product.price}
                    disabled={product.disabled}
                    number={index + 1}
                />
            ))}
        </div>
    </div>
</Layout>


<style>
    .category {
        padding-bottom: 80px;
    }

    .category__crumbs {
        font-size: 14px;
        color: var(--vg-muted);
        margin-top: 4px;
    }

    .category__crumbs a:hover {
        color: var(--vg-rust);
    }

    .category__intro {
        margin: 20px 0 8px;
    }

    .category__title {
        font-family: var(--vg-display);
        font-weight: 400;
        font-size: clamp(42px, 6vw, 68px);
        line-height: 1;
        color: var(--vg-rust);
        margin: 0 0 10px;
    }
</style>
