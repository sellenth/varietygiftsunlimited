---
import Layout from "../layouts/Layout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import Card from "../components/Card.astro";
import { categories } from "../data/categories";
import { products } from "../data/products";
import { featuredProducts } from "../data/featuredProducts";

export const prerender = true;

// Calculate product counts for each category
const categoryProductCounts = categories.map(category => ({
    ...category,
    productCount: products.filter(p => p.category === category.id).length
}));
---

<Layout title="Shop - Variety Gifts Unlimited" hideHeader={false}>
    <div class="vg-wrap shop">
        <section class="shop__intro">
            <h1 class="shop__title">The catalog</h1>
            <p class="vg-sub">Fun gifts for fun people. Perfect for every occasion!</p>
        </section>

        <nav class="vg-chips" aria-label="Shop by category">
            {categories.map(category => (
                <a href={`/shop/category/${category.slug}`} class="vg-chip">{category.name}</a>
            ))}
        </nav>

        <section id="products" class="shop__section">
            <h2 class="vg-title">Featured products</h2>
            <p class="vg-sub">Hand-picked favorites from the catalog.</p>
            <div class="vg-grid">
                {featuredProducts.map((product, index) => (
                    <Card
                        img={product.images[0].src}
                        title={product.name}
                        body={product.description}
                        href={`/shop/product/${product.slug}`}
                        price={product.price}
                        disabled={product.disabled}
                        number={index + 1}
                    />
                ))}
            </div>
        </section>

        <section class="shop__section">
            <h2 class="vg-title">Browse by category</h2>
            <p class="vg-sub">Sweaters, tees, bags, hats and goodies for your pets.</p>
            <div class="vg-grid">
                {categoryProductCounts.map(category => (
                    <CategoryCard
                        href={`/shop/category/${category.slug}`}
                        title={category.name}
                        body={category.description}
                        img={category.image}
                        productCount={category.productCount}
                    />
                ))}
            </div>
        </section>
    </div>
</Layout>

<style>
    .shop {
        padding-bottom: 80px;
    }

    .shop__intro {
        margin: 24px 0 28px;
    }

    .shop__title {
        font-family: var(--vg-display);
        font-weight: 400;
        font-size: clamp(46px, 7vw, 76px);
        line-height: 1;
        color: var(--vg-rust);
        margin: 0 0 10px;
    }

    .shop__section {
        margin-top: 64px;
        scroll-margin-top: 24px;
    }
</style>
