---
import Layout from "../layouts/Layout.astro";

const title = "Arena 2006 — iPhone Campaign & Desktop Downloads";
const description = "Get Arena 2006 on the App Store or download it for Windows and Linux. Play the iPhone campaign with Black Sand free, two premium missions, and optional rewarded attempts.";
const appStoreUrl = "https://apps.apple.com/us/app/arena2006/id6814988988";
const bucketBase = "https://storage.googleapis.com/arena2006-downloads";
// Verified against the public desktop manifest and both download URLs on 2026-09-22.
const fallbackCommit = "d1719949f4f323cd33a18a119db8a92dbab71c3d";
---

<Layout
    title={title}
    hideHeader={true}
    description={description}
    ogTitle={title}
    ogUrl="https://www.variety.gifts/arena2006"
    ogImage="https://www.variety.gifts/arena2006/arena2006-key-art.png"
>
    <main class="arena-page">
        <div class="main-wrapper">
            <header class="arena-header">
                <a class="wordmark" href="/arena2006" aria-label="Arena 2006 home">ARENA<span>2006</span></a>
                <a class="home-link" href="/">« Variety Gifts</a>
            </header>
            <nav class="arena-nav" aria-label="Arena 2006">
                <a href="#iphone">iPhone campaign</a>
                <a href="#desktop">Desktop downloads</a>
                <a href="/contact/">Support</a>
                <a href="/privacy-policy#arena2006-ios">Privacy</a>
            </nav>

            <figure class="hero-art">
                <img
                    src="/arena2006/arena2006-key-art.png"
                    alt="Arena 2006 artwork: an armored fighter beside a glowing arena at night."
                    width="1232"
                    height="706"
                    fetchpriority="high"
                />
            </figure>

            <div class="page-intro">
                <p class="eyebrow">Arena 2006</p>
                <h1>A new campaign. Now on iPhone.</h1>
                <p>The iPhone campaign is available on the App Store. Windows and Linux desktop downloads are also available.</p>
                <a class="app-store-button" href={appStoreUrl}>Download on the App Store <span aria-hidden="true">↗</span></a>
            </div>

            <div class="content-layout">
                <section class="panel campaign" id="iphone" aria-labelledby="iphone-title">
                    <div class="panel-header">
                        <h2 id="iphone-title">iPhone campaign</h2>
                        <a class="status-badge" href={appStoreUrl}>Available now <span aria-hidden="true">↗</span></a>
                    </div>
                    <div class="panel-body">
                        <p class="lead">Three missions. Start with Black Sand, free.</p>
                        <p>Free to download for iPhone. No player account or game login is required.</p>

                        <ol class="missions">
                            <li>
                                <span class="mission-number">01</span>
                                <div><h3>Black Sand</h3><p>Free to play.</p></div>
                                <span class="mission-tag">Free</span>
                            </li>
                            <li>
                                <span class="mission-number">02</span>
                                <div><h3>Arctic Terminal</h3><p>Included in the premium unlock.</p></div>
                            </li>
                            <li>
                                <span class="mission-number">03</span>
                                <div><h3>Meridian Coast</h3><p>Included in the premium unlock.</p></div>
                            </li>
                        </ol>

                        <div class="purchase-details">
                            <h3>One purchase. Both premium missions.</h3>
                            <p class="price">US $4.99 <span>one-time purchase</span></p>
                            <p>A single non-consumable purchase unlocks Arctic Terminal and Meridian Coast with unlimited attempts and no required ads. No subscription.</p>
                            <p class="fine-print">$4.99 is the US base price; the price shown in the app is localized for your App Store storefront. Story progression still applies.</p>
                        </div>

                        <h3 class="section-heading">Or choose a rewarded attempt</h3>
                        <p>If you do not own the premium missions, you can optionally watch a rewarded ad to earn one attempt at the selected premium mission, when an ad is available.</p>
                        <ul class="details-list">
                            <li>Skipped, closed early, or failed ads do not grant an attempt.</li>
                            <li>Checkpoint recovery and self-revival stay within the same attempt.</li>
                            <li>Once you enter the mission, leaving or unloading it consumes that attempt. A failed load does not.</li>
                            <li>Rewarded attempts also follow the story progression gates.</li>
                        </ul>
                        <p><strong>Restore Purchases</strong> is included for restoring the premium unlock through the Apple account used to buy it. Apple processes payments.</p>
                        <div class="help-links">
                            <a href="/privacy-policy#arena2006-ios">iPhone privacy details →</a>
                            <a href="/contact/">Game support →</a>
                        </div>
                    </div>
                </section>

                <aside class="desktop-column">
                    <section class="panel" id="desktop" aria-labelledby="desktop-title">
                        <div class="panel-header"><h2 id="desktop-title">Desktop downloads</h2></div>
                        <div class="panel-body">
                            <p>Arena 2006 for Windows and Linux is available now. These desktop clients are separate from the iPhone campaign.</p>
                            <p id="build-info" class="build-status" aria-live="polite">Desktop download links ready.</p>
                            <div class="package-card">
                                <h3>Windows</h3>
                                <p>Free desktop client</p>
                                <a id="windows-download" class="download-button" href={`${bucketBase}/${fallbackCommit}/windows_client.zip`}>Download for Windows</a>
                            </div>
                            <div class="package-card">
                                <h3>Linux</h3>
                                <p>Free native Linux client</p>
                                <a id="linux-download" class="download-button" href={`${bucketBase}/${fallbackCommit}/linux_client.zip`}>Download for Linux</a>
                            </div>
                            <p class="fine-print">The iPhone purchase and rewarded-attempt options above apply to the iPhone campaign.</p>
                        </div>
                    </section>
                    <section class="panel" aria-labelledby="trailer-title">
                        <div class="panel-header"><h2 id="trailer-title">From the desktop game</h2></div>
                        <div class="panel-body">
                            <p>See Arena 2006 in action on desktop.</p>
                            <a class="text-link" href="https://youtu.be/pIkLnhj5-uU?si=75mAQz2vaHc9LIVZ" target="_blank" rel="noopener noreferrer">Watch the desktop trailer ↗</a>
                        </div>
                    </section>
                    <section class="panel" aria-labelledby="support-title">
                        <div class="panel-header"><h2 id="support-title">Need a hand?</h2></div>
                        <div class="panel-body">
                            <p>For Arena 2006 support or privacy questions:</p>
                            <a class="text-link support-email" href="mailto:varietygiftsunlimited@gmail.com">varietygiftsunlimited@gmail.com</a>
                            <p><a class="text-link" href="/contact/">Visit the support page →</a></p>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </main>
</Layout>

<script>
    const bucketBase = "https://storage.googleapis.com/arena2006-downloads";
    const buildInfo = document.getElementById("build-info");
    const windowsLink = document.getElementById("windows-download") as HTMLAnchorElement;
    const linuxLink = document.getElementById("linux-download") as HTMLAnchorElement;

    async function updateDesktopDownloads() {
        try {
            const response = await fetch(`${bucketBase}/latest.json`);
            if (!response.ok) throw new Error("Desktop manifest unavailable");
            const build = await response.json();
            if (typeof build.commitSha !== "string" || !/^[a-f0-9]{7,40}$/i.test(build.commitSha)) {
                throw new Error("Invalid desktop build identifier");
            }
            windowsLink.href = `${bucketBase}/${build.commitSha}/windows_client.zip`;
            linuxLink.href = `${bucketBase}/${build.commitSha}/linux_client.zip`;
            if (buildInfo) buildInfo.textContent = `Latest desktop build: ${build.commitSha.slice(0, 7)}`;
        } catch {
            if (buildInfo) buildInfo.textContent = "Showing the last linked desktop build. Latest build information is unavailable.";
        }
    }
    updateDesktopDownloads();
</script>

<style>
    h1, h2, h3 { font-family: Verdana, Tahoma, sans-serif; }
    .arena-page { background: #080e16; color: #c5d3e2; font-family: Verdana, Tahoma, sans-serif; font-size: 14px; line-height: 1.7; padding-bottom: 48px; }
    .main-wrapper { max-width: 1100px; margin: 0 auto; background: #0d1622; border-inline: 1px solid #29415f; }
    .arena-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 28px; background: linear-gradient(#193b66, #102744); }
    .wordmark { color: #fff; font-family: "Arial Black", sans-serif; font-size: 30px; font-weight: 900; letter-spacing: -1px; line-height: 1; }
    .wordmark span { color: #74b8ff; }
    .home-link { color: #cfdef0; font-size: 12px; }
    .arena-nav { display: flex; flex-wrap: wrap; padding-inline: 12px; background: #0d2139; border-block: 1px solid #345b88; }
    .arena-nav a { padding: 12px 16px; color: #d4e7ff; font-size: 12px; font-weight: bold; }
    .arena-nav a:hover { background: #203f63; }
    a:focus-visible { outline: 3px solid #82c6ff; outline-offset: 4px; }
    .hero-art { margin: 0; border-bottom: 1px solid #29415f; }
    .hero-art img { display: block; width: 100%; height: auto; }
    .page-intro { padding: 30px 28px; }
    .app-store-button { display: inline-flex; align-items: center; gap: 12px; margin-top: 20px; padding: 12px 20px; border: 1px solid #c7e2ff; border-radius: 4px; background: #e8f3ff; color: #102744; font-size: 14px; font-weight: bold; }
    .app-store-button:hover { background: #fff; }
    .eyebrow { color: #79b9ff; text-transform: uppercase; letter-spacing: 0.16em; font-size: 11px; font-weight: bold; margin-bottom: 8px; }
    h1 { color: #f3f7fc; font-size: clamp(24px, 4vw, 34px); line-height: 1.25; font-weight: bold; margin-bottom: 12px; }
    .content-layout { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); align-items: start; gap: 20px; padding: 0 28px 32px; }
    .panel { border: 1px solid #345477; background: #111e2d; scroll-margin-top: 20px; }
    .panel-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 13px 18px; background: linear-gradient(#1d416a, #122c4a); border-bottom: 1px solid #345477; }
    h2 { color: #f1f6ff; font-size: 16px; font-weight: bold; }
    h3 { color: #edf5ff; font-size: 14px; font-weight: bold; }
    .status-badge { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: bold; color: #a8dcff; border: 1px solid #4c7ea8; padding: 3px 8px; }
    .panel-body { padding: 20px; }
    .panel-body > p + p { margin-top: 12px; }
    .lead { font-size: 19px; color: #edf5ff; font-weight: bold; line-height: 1.4; }
    .missions { list-style: none; padding: 0; margin: 24px 0; }
    .missions li { display: flex; align-items: center; gap: 14px; padding: 15px 0; border-block-start: 1px solid #2b415a; }
    .missions li:last-child { border-block-end: 1px solid #2b415a; }
    .missions p { font-size: 12px; color: #aebfd2; }
    .mission-number { color: #85bffb; font: bold 19px monospace; }
    .mission-tag { margin-left: auto; font-size: 10px; text-transform: uppercase; color: #b0eacb; background: #183e33; padding: 2px 7px; }
    .purchase-details { background: #0a1827; border-left: 3px solid #73baff; padding: 18px; margin-bottom: 24px; }
    .purchase-details p { margin-top: 12px; }
    .price { font-size: 24px; color: #fff; font-weight: bold; }
    .price span { display: inline-block; font-size: 12px; font-weight: normal; color: #bdcfe3; }
    .fine-print { color: #aebfd2; font-size: 12px; }
    .section-heading { margin-bottom: 10px; }
    .details-list { list-style: disc; padding-left: 20px; margin: 14px 0 20px; }
    .details-list li + li { margin-top: 8px; }
    .help-links { display: flex; gap: 12px 24px; flex-wrap: wrap; border-top: 1px solid #2b415a; margin-top: 24px; padding-top: 18px; }
    .help-links a, .text-link { color: #96cbff; text-decoration: underline; text-underline-offset: 3px; }
    .desktop-column { display: grid; gap: 20px; min-width: 0; }
    .build-status { font: 11px/1.6 monospace; padding: 10px; background: #091421; border: 1px solid #2d4764; }
    .package-card { padding: 18px 0; border-bottom: 1px solid #2b415a; }
    .package-card p { font-size: 12px; margin: 4px 0 12px; }
    .package-card + .fine-print { margin-top: 16px; }
    .download-button { display: block; text-align: center; color: #fff; font-size: 12px; font-weight: bold; padding: 11px; background: linear-gradient(#245b96, #153e6a); border: 1px solid #5c91c7; }
    .download-button:hover { background: #2b6098; }
    .support-email { overflow-wrap: anywhere; }
    @media (max-width: 720px) {
        .arena-header { padding: 20px 16px; }
        .wordmark { font-size: 25px; }
        .arena-nav { padding-inline: 4px; }
        .arena-nav a { padding: 10px 12px; }
        .page-intro { padding: 25px 18px; }
        .content-layout { grid-template-columns: 1fr; padding: 0 14px 24px; }
        .panel-body { padding: 18px; }
    }
</style>
