---
export interface Props {
    href: string;
    title: string;
    body: string;
    img: string;
    productCount?: number;
}

const { href, title, body, img, productCount } = Astro.props;
---

<a href={href} class="vg-card vg-category">
    <div class="vg-card__img">
        <img class="vg-card__main" src={img} alt={title} loading="lazy" />
    </div>
    <div class="vg-card__info">
        <h3 class="vg-card__name">{title}</h3>
        <p class="vg-category__body">{body}</p>
        {productCount && (
            <p class="vg-category__count">{productCount} {productCount === 1 ? 'product' : 'products'} →</p>
        )}
    </div>
</a>

<style>
    .vg-category__body {
        margin: 0 0 8px;
        font-size: 15px;
        line-height: 1.4;
        color: var(--vg-muted);
    }

    .vg-category__count {
        margin: 0;
        font-weight: 700;
        color: var(--vg-teal);
    }
</style>
