---
const links = [
  { label: "Shop", href: "/shop" },
  { label: "Sweaters & Tees", href: "/shop/category/shirts" },
  { label: "Bags", href: "/shop/category/bags" },
  { label: "Pets", href: "/shop/category/accessories" },
  { label: "Games", href: "/game-browser" },
  { label: "Contact", href: "/contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/shop" ? path === "/shop" : path === href || path.startsWith(`${href}/`);
---

<header class="vg-header">
  <div class="vg-stripes"></div>
  <div class="vg-header__bar">
    <a href="/" class="vg-header__logo" aria-label="Variety Gifts home">Variety Gifts</a>
    <nav class="vg-header__nav" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .vg-header__bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    flex-wrap: wrap;
  }

  .vg-header__logo {
    font-family: var(--vg-display);
    font-size: 34px;
    line-height: 1.1;
    color: var(--vg-rust);
    text-shadow: 3px 3px 0 var(--vg-mustard);
    white-space: nowrap;
  }

  .vg-header__nav {
    display: flex;
    gap: 22px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.06em;
  }

  .vg-header__nav a {
    color: var(--vg-ink);
    padding: 4px 0;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .vg-header__nav a:hover {
    color: var(--vg-rust);
  }

  .vg-header__nav a[aria-current="page"] {
    border-bottom-color: var(--vg-mustard);
  }

  @media (max-width: 767px) {
    .vg-header__bar {
      padding: 14px 16px 10px;
    }

    .vg-header__logo {
      font-size: 28px;
    }

    .vg-header__nav {
      width: 100%;
      gap: 18px;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 4px;
      font-size: 13px;
    }

    .vg-header__nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
