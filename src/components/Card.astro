---
interface Props {
	img: string;
	hoverImg?: string;
	sticker?: string;
	title: string;
	body: string;
	href: string;
	price?: string;
	disabled?: boolean;
	/** Catalog number shown as a "No. 001" tag. */
	number?: number;
}

const { img, hoverImg, href, title, price, disabled = false, number } = Astro.props;
const catalogNo = number !== undefined ? `No. ${String(number).padStart(3, "0")}` : null;
---

{!disabled ? (
	<a href={href} class="vg-card">
		{catalogNo && <span class="vg-card__no">{catalogNo}</span>}
		<div class="vg-card__img">
			<img class="vg-card__main" src={img} alt={title} loading="lazy" />
			{hoverImg && (
				<img class="vg-card__hover" src={hoverImg} alt={`${title} - On Model`} loading="lazy" />
			)}
		</div>
		<div class="vg-card__info">
			<h3 class="vg-card__name">{title}</h3>
			{price && <p class="vg-card__price">{price}</p>}
		</div>
	</a>
) : (
	<div class="vg-card vg-card--disabled" aria-disabled="true">
		{catalogNo && <span class="vg-card__no">{catalogNo}</span>}
		<div class="vg-card__img">
			<img class="vg-card__main select-none" src={img} alt={title} loading="lazy" />
			<div class="vg-card__flag"><span>Unavailable</span></div>
		</div>
		<div class="vg-card__info">
			<h3 class="vg-card__name">{title}</h3>
			{price && <p class="vg-card__price">{price}</p>}
		</div>
	</div>
)}
