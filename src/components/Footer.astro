---
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
---

<footer class="vg-footer">
  <div class="vg-stripes"></div>
  <div class="vg-footer__inner">
    <a href="/" class="vg-footer__logo">Variety Gifts</a>
    <p class="vg-footer__tag">Lots of good stuff, all in one place.</p>
    <SocialLinks wrapperClass="vg-footer__social" linkClass="vg-footer__icon" />
    <nav class="vg-footer__links" aria-label="Footer">
      <a href="/shop">Shop</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy-policy">Privacy Policy</a>
    </nav>
    <p class="vg-footer__copy">© {year} Variety Gifts Unlimited</p>
  </div>
</footer>

<style>
  .vg-footer {
    background: var(--vg-ink);
    color: var(--vg-cream);
  }

  .vg-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 36px 24px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .vg-footer__logo {
    font-family: var(--vg-display);
    font-size: 30px;
    color: var(--vg-mustard);
  }

  .vg-footer__tag {
    margin: 0;
    color: var(--vg-paper);
  }

  .vg-footer :global(.vg-footer__social) {
    display: flex;
    gap: 14px;
  }

  .vg-footer :global(.vg-footer__icon) {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--vg-rust);
    border: 3px solid var(--vg-cream);
    color: var(--vg-cream);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .vg-footer :global(.vg-footer__icon:hover) {
    background: var(--vg-teal);
    transform: translateY(-3px);
  }

  .vg-footer :global(.vg-footer__icon svg) {
    width: 22px;
    height: 22px;
  }

  .vg-footer__links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    justify-content: center;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 13px;
  }

  .vg-footer__links a {
    color: var(--vg-cream);
  }

  .vg-footer__links a:hover {
    color: var(--vg-mustard);
  }

  .vg-footer__copy {
    margin: 0;
    font-size: 13px;
    opacity: 0.75;
  }
</style>
